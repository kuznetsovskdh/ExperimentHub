# Скопируйте в .env и при необходимости поменяйте значения.
# Файл .env в git не коммитится; docker-compose подставляет значения
# по умолчанию, если переменная не задана, — стек поднимается и без .env.

POSTGRES_USER=eh_user
POSTGRES_PASSWORD=eh_pass
POSTGRES_DB=experimenthub
POSTGRES_PORT=5432

APP_PORT=8001

# Подключение к БД SalesGuard для DiD-анализа (clients/salesguard_client.py).
# Хост указывается изнутри docker-сети eh_network.
SG_DB_HOST=salesguard-db-1
SG_DB_PORT=5432
SG_DB_NAME=salesguard
SG_DB_USER=sguser
SG_DB_PASSWORD=sgpass
